{
  "name": "pi-show-tps",
  "version": "0.1.0",
  "description": "Shows the live output token rate (tok/s), time to first token (TTFT) and elapsed response time of the current model in the pi TUI status bar.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tokens",
    "token-rate",
    "tps",
    "ttft",
    "elapsed",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ApigeonAPE/pi-show-tps.git"
  },
  "bugs": {
    "url": "https://github.com/ApigeonAPE/pi-show-tps/issues"
  },
  "homepage": "https://github.com/ApigeonAPE/pi-show-tps#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "fix": "biome check --write",
    "verify": "pnpm typecheck && pnpm check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  }
}
